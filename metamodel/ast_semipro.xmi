      <penalty xsi:type="racespec:ExtraLapPenalty" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" lapLength="100.0"/>
    </stages>
    <stages xsi:type="racespec:SkiStage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" distance="3.75"/>
    <stages xsi:type="racespec:ShootingStage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetCount="5" position="laying">
      <penalty xsi:type="racespec:ExtraLapPenalty" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" lapLength="100.0"/>
    </stages>
    <stages xsi:type="racespec:SkiStage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" distance="3.75"/>
    <stages xsi:type="racespec:ShootingStage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetCount="5" position="standing">
      <penalty xsi:type="racespec:ExtraLapPenalty" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" lapLength="100.0"/>
    </stages>
    <stages xsi:type="racespec:SkiStage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" distance="3.75"/>
    <stages xsi:type="racespec:ShootingStage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetCount="5" position="laying">
      <penalty xsi:type="racespec:TimePenalty" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" secondsPerMiss="30" maxSeconds="0"/>
    </stages>
    <startCondition xsi:type="racespec:IntervalStart" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" intervalSeconds="30"/>
  </competitions>
</racespec:Event>