<?xml version="1.0" encoding="UTF-8"?>
<racespec:Event xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:racespec="http://www.xtext.org/racespec/RaceSpec"
    name="Harz Mountain Winter 2025" location="Clausthal-Altenau" year="2025">
  <course totalLength="15.0" firingPositions="10">
    <shootingRanges rangeId="1" hasExtraLap="true" extraLapLength="100.0"/>
