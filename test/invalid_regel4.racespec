event "Test R4" {
    location: "Testort"
    year: 2025
    course { length: 15.0km shootingRanges: 2 firingPositions: 10 }
    competition "Invalid Penalty" {
        type: individual
        teamSize: 1
        distance: 15.0km
        maxParticipants: 10
        start: interval(30sec)
        stage ski(7.5km)
        stage shooting(standing) {
            penalty: timePenalty(15sec max: 40sec)
        }
        stage ski(7.5km)
        stage shooting(laying) {
            penalty: extraLap(100.0m)
        }
    }
}